{
  "name": "kasuwa-shield",
  "version": "1.0.0",
  "private": true,
  "description": "Programmable Downside Protection using DreamDEX Event Contracts on Somnia Network",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev apps/web",
    "build": "next build apps/web",
    "test": "tsx scripts/run-tests.ts",
    "test:e2e": "tsx scripts/e2e-live-integration.ts",
    "test:audit": "tsx scripts/e2e-proof-test.ts",
    "audit:claims": "tsx scripts/audit-claims.ts",
    "audit:slither": "python scripts/run-slither-audit.py",
    "verify:testnet-wallet": "tsx scripts/verify-testnet-wallet.ts",
    "verify:self-serve": "tsx scripts/verify-self-serve-flow.ts",
    "verify:routes": "node scripts/verify-routes.js",
    "live:testnet": "tsx scripts/live-testnet-runner.ts",
    "deploy:testnet": "tsx scripts/deploy-contracts.ts",
    "typecheck": "tsc --noEmit && tsc --project apps/web/tsconfig.json --noEmit",
    "discover": "tsx scripts/discover-markets.ts",
    "inspect": "tsx scripts/inspect-market.ts",
    "preflight": "tsx scripts/demo-preflight.ts",
    "smoke": "tsx scripts/testnet-smoke.ts",
    "place-order": "tsx scripts/place-real-dreamdex-order.ts",
    "keeper": "tsx scripts/keeper-daemon.ts",
    "keeper:status": "tsx scripts/keeper-watchdog.ts",
    "reactive:rollover": "tsx scripts/trigger-reactive-rollover.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7"
  },
  "dependencies": {
    "next": "14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "lucide-react": "^0.424.0",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.4.0",
    "recharts": "^2.12.7",
    "framer-motion": "^11.3.19",
    "viem": "^2.21.0",
    "dotenv": "^16.4.5",
    "@somnia-chain/markets-sdk": "^0.28.1"
  }
}
